{
  "scenarios": [
    {
      "name": "existing_artifact",
      "sources": ["skill"],
      "required": [
        "measure --input",
        "skip installation",
        "unless a new capture is required"
      ]
    },
    {
      "name": "live_target",
      "sources": ["skill"],
      "required": [
        "live target",
        "representative cycle",
        "validate",
        "no fixed procedure"
      ]
    },
    {
      "name": "triage_reference",
      "sources": ["skill", "artifacts"],
      "required": [
        "--triage",
        "a reference, not a verdict",
        "not_covered",
        "confirm a finding with a direct measurement"
      ]
    },
    {
      "name": "several_boundaries",
      "sources": ["skill", "selectors"],
      "required": [
        "measurement graph",
        "up to eight edges",
        "at most two syscall, tracepoint, or usdt endpoints"
      ]
    },
    {
      "name": "gpu_idle",
      "sources": ["skill", "artifacts"],
      "required": [
        "--trigger-idle-ms",
        "a stream gap is not device idle time",
        "all_gpu_activity",
        "--slice-gap",
        "cuda_devices"
      ]
    },
    {
      "name": "python_semantics",
      "sources": ["skill", "artifacts", "selectors"],
      "required": [
        "python_status",
        "native frames only",
        "--python-sample",
        "python:gc_start",
        "check capability, not the process name"
      ]
    },
    {
      "name": "multi_process",
      "sources": ["skill", "multi_process"],
      "required": [
        "discover --pid root",
        "pid plus process start time",
        "do not cancel sibling commands",
        "do not concatenate artifacts",
        "compare their shares, never their timestamps"
      ]
    },
    {
      "name": "container_namespace",
      "sources": ["skill", "setup"],
      "required": [
        "container target",
        "pid and mount namespaces",
        "namespace-local pid",
        "do not guess a pod, container, or pid",
        "does not add capabilities"
      ]
    }
  ]
}
